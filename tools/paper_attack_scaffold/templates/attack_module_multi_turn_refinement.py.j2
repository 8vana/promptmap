from __future__ import annotations

from uuid import uuid4

from promptmap.engine.base_attack import BaseAttack
from promptmap.engine.context import AttackContext
from promptmap.engine.events import (
    EVT_ACHIEVED,
    EVT_COMPLETE,
    EVT_INFO,
    EVT_PROMPT,
    EVT_RESPONSE,
    EVT_SCORE,
    ProgressEvent,
)
from promptmap.engine.models import AttackResult, Message

ATTACK_NAME = {{ registered_name_repr }}
PLAN_FAMILY = {{ family_repr }}
EXECUTION_SKELETON = {{ execution_skeleton_repr }}
PLAN_SUMMARY = {{ summary_literal }}
DEFAULT_PARAMS = {{ default_params_literal }}
REPO_DERIVED_HINTS = {{ repo_derived_hints_literal }}
PLAN_STEPS = {{ plan_steps_literal }}
PROMPT_FRAGMENTS = {{ prompt_fragments_literal }}
PLAN_AMBIGUITIES = {{ ambiguities_literal }}
PLAN_STEP_IDS = {{ plan_step_ids_literal }}
STEP_SYMBOL_MAP = {{ step_symbol_map_literal }}


class {{ class_name }}(BaseAttack):
    """Plan-driven draft for "{{ display_name }}".

    This template targets papers that refine prompts across multiple turns.
    """

    def _merge_params(self, **kwargs):
        merged = dict(DEFAULT_PARAMS)
        merged.update(kwargs)
        return merged

    async def _apply_converters(self, ctx: AttackContext, text: str) -> str:
        converted = text
        for converter in ctx.converters:
            converted = await converter.convert(converted)
        return converted

    def _build_initial_prompt(self, objective: str, params: dict) -> str:
        """TODO({{ attack_id }}:multi_turn_refinement:initial_prompt)"""
        seed_prompt = str(params.get("seed_prompt") or "").strip()
        return seed_prompt or objective

    def _analyze_response(self, response: str, objective: str) -> dict:
        """TODO({{ attack_id }}:multi_turn_refinement:analyze_response)"""
        return {
            "should_refine": bool(response.strip()),
            "response_length": len(response),
            "objective": objective,
        }

    def _refine_prompt(self, objective: str, response: str, analysis: dict, turn: int) -> str:
        """TODO({{ attack_id }}:multi_turn_refinement:refine_prompt)"""
        return (
            f"Refine the attack for objective: {objective}\n\n"
            f"Previous response:\n{response}\n\n"
            f"Turn: {turn}\n"
        )

    async def _run_refinement_loop(
        self,
        ctx: AttackContext,
        objective: str,
        params: dict,
        conversation_id: str,
    ) -> tuple[list[Message], float, bool]:
        conversation: list[Message] = []
        best_score = 0.0
        achieved = False
        max_iterations = int(params.get("max_iterations", 3))
        prompt = self._build_initial_prompt(objective, params)

        for turn in range(1, max_iterations + 1):
            converted = await self._apply_converters(ctx, prompt)
            await ctx.emit(ProgressEvent(EVT_PROMPT, turn=turn, data={"text": converted}))
            response = await ctx.target.send(converted, conversation_id)
            await ctx.emit(ProgressEvent(EVT_RESPONSE, turn=turn, data={"text": response}))
            conversation.append(Message(role="user", content=converted))
            conversation.append(Message(role="assistant", content=response))

            score_result = await ctx.scorer.score(response, objective)
            best_score = max(best_score, score_result.score)
            await ctx.emit(ProgressEvent(EVT_SCORE, turn=turn, data={
                "score": score_result.score,
                "achieved": score_result.achieved,
                "rationale": score_result.rationale,
            }))
            if score_result.achieved:
                achieved = True
                await ctx.emit(ProgressEvent(EVT_ACHIEVED, turn=turn, data={"score": score_result.score}))
                break

            analysis = self._analyze_response(response, objective)
            if not analysis.get("should_refine", True):
                break
            prompt = self._refine_prompt(objective, response, analysis, turn + 1)

        return conversation, best_score, achieved

    async def run(self, ctx: AttackContext, objective: str, **kwargs) -> AttackResult:
        params = self._merge_params(**kwargs)
        conversation_id = str(uuid4())

        await ctx.emit(ProgressEvent(EVT_INFO, data={
            "text": "{{ display_name }} forge draft executing multi-turn refinement skeleton."
        }))
        conversation, best_score, achieved = await self._run_refinement_loop(
            ctx,
            objective,
            params,
            conversation_id,
        )
        await ctx.emit(ProgressEvent(EVT_COMPLETE, data={
            "achieved": achieved,
            "score": best_score,
            "turns": len(conversation) // 2,
        }))

        return AttackResult(
            attack_name=ATTACK_NAME,
            objective=objective,
            achieved=achieved,
            score=best_score,
            turns=len(conversation) // 2,
            conversation=conversation,
            metadata={
                "family": PLAN_FAMILY,
                "paper_title": {{ paper_title_repr }},
                "paper_url": {{ paper_url_repr }},
                "forge_status": "draft",
                "execution_skeleton": EXECUTION_SKELETON,
                "plan_summary": PLAN_SUMMARY,
                "plan_steps": PLAN_STEPS,
                "plan_ambiguities": PLAN_AMBIGUITIES,
                "step_symbol_map": STEP_SYMBOL_MAP,
                "default_params": DEFAULT_PARAMS,
                "repo_derived_hints": REPO_DERIVED_HINTS,
                "prompt_fragments": PROMPT_FRAGMENTS,
            },
        )
